# Approx AI — environment template (root). Copy the relevant parts to your deployment.
# Full, annotated examples: deploy/approx.env.example (backend) and deploy/inference.env.example (GPU inference).
# NEVER commit real secrets. Generate keys with: openssl rand -hex 32

# ---- Backend (deploy/approx.env) ----
APPROX_PUBLIC_URL=https://ai.your-domain.example
PORT=8080
APPROX_TRUST_PROXY=1
# Inference: point each family at the Approx inference server; leave *_NAME unset to serve the registry version.
APPROX_MODEL_NICK_URL=http://inference:8000/v1
APPROX_MODEL_NICK_KEY=
# Model registry (shared with the training pipeline + inference server)
APPROX_MODELS_DIR=/models
APPROX_AUTO_ACTIVATE=off
APPROX_INFERENCE_ADMIN_URL=http://inference:8000
APPROX_INFERENCE_ADMIN_KEY=
APPROX_RELEASE_SIGNING_KEY=
# Optional FAB 500X media pipelines (unset → endpoints answer 501 capability_unavailable)
APPROX_VIDEO_PIPELINE_URL=
APPROX_VIDEO_UNDERSTANDING_URL=
APPROX_VISION_URL=
APPROX_AUDIO_URL=
# Transactional email (required for signup verification + password reset in production)
#   smtp  — any SMTP server; defaults to Gmail (smtp.gmail.com:465, TLS) with a Google App Password
#   brevo — Brevo free plan, one verified sender address, no domain needed
#   http  — Resend-compatible JSON API (needs a domain you own to mail arbitrary users)
MAIL_TRANSPORT=smtp
# SMTP: username defaults to APPROX_BOOTSTRAP_SUPERADMIN_EMAIL; host/port/secure default to Gmail.
# MAIL_SMTP_USER=          (only if different from APPROX_BOOTSTRAP_SUPERADMIN_EMAIL)
MAIL_SMTP_PASS=
# MAIL_SMTP_HOST=smtp.gmail.com   MAIL_SMTP_PORT=465   MAIL_SMTP_SECURE=true
# brevo / http only:
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_API_KEY=
# Optional sender; with SMTP it defaults to "Approx AI <SMTP username>" (Gmail only sends as that account).
MAIL_FROM=
# This email becomes superadmin once, after it is verified (no CLI needed).
APPROX_BOOTSTRAP_SUPERADMIN_EMAIL=

# ---- Database / storage ----
# Unset → local SQLite file in data/ (Docker/Render with a disk). Serverless (Vercel) REQUIRES a remote libSQL DB:
# APPROX_DB_URL=libsql://<db>-<org>.turso.io
# APPROX_DB_AUTH_TOKEN=            (secret)
# APPROX_FILE_STORAGE=fs|db        (default: db on Vercel or with a remote DB, fs otherwise)
# APPROX_REGISTRY_SOURCE=local|inference   (default: inference on Vercel — the GPU host decides what is served)

# ---- Inference server (deploy/inference.env) ----
INFERENCE_API_KEY=
INFERENCE_ADMIN_KEY=
INFERENCE_MODELS=
# HF_TOKEN only if a base model is gated (never logged)
HF_TOKEN=

# ---- Training pipeline (set on the GPU runtime) ----
# APPROX_MODELS_DIR=/content/drive/MyDrive/ApproxAI/registry
# APPROX_CONTROL_PLANE_URL=https://ai.your-domain.example   APPROX_WORKER_API_KEY=apx_...  (for --worker mode)
# APPROX_RELEASE_SIGNING_KEY=   (must match the backend when releases are signed)
