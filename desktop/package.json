{
  "name": "approx-desktop",
  "productName": "Approx",
  "version": "1.7.0",
  "description": "Approx for Windows",
  "author": "Approx Technology",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/updater.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.approxtech.approx.desktop",
    "productName": "Approx",
    "files": ["main.js", "preload.js", "updater.js", "icon.png", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png", "artifactName": "Approx.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "allowElevation": false, "deleteAppDataOnUninstall": false, "runAfterFinish": true }
  }
}
