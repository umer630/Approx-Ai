{
  "run_name": "nick-4.8-qlora-v1",
  "model_id": "nick-4.8",
  "adapter_version": "1.0.0",
  "base_model": "Qwen/Qwen2.5-3B-Instruct",
  "base_model_revision": null,
  "base_model_revision_note": "null = latest on the Hub; the resolved commit SHA is recorded in train_metadata.json. Set a SHA here to pin exactly.",
  "base_model_license": "Qwen license as published on the model card — verify before commercial deployment",
  "dataset_dir": "data/processed",
  "output_dir": "outputs/nick-4.8-qlora-v1",
  "max_seq_length": 2048,
  "quantization": { "load_in_4bit": true, "bnb_4bit_quant_type": "nf4", "bnb_4bit_use_double_quant": true, "bnb_4bit_compute_dtype": "bfloat16" },
  "lora": { "r": 16, "alpha": 32, "dropout": 0.05, "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"] },
  "train": {
    "epochs": 3,
    "per_device_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.0002,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.0,
    "max_grad_norm": 0.3,
    "gradient_checkpointing": true,
    "max_save_steps": 200,
    "checkpoints_per_epoch": 2,
    "save_total_limit": 3,
    "logging_steps": 1,
    "seed": 4848
  },
  "hardware_notes": "Single 16 GB GPU (Kaggle T4). bf16 is used when supported; T4/P100 automatically fall back to fp16 compute. Only GPU 0 is used even on 2xT4."
}
