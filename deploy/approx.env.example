# Copy to approx.env and fill in. NEVER commit approx.env.
APPROX_PUBLIC_URL=https://ai.your-domain.example
APPROX_TRUST_PROXY=1
APPROX_BUILD_ID=
# Inference (OpenAI-compatible). Nick via local vLLM; others may point at their own servers.
APPROX_MODEL_NICK_URL=http://inference:8000/v1
APPROX_MODEL_NICK_NAME=nick-4.8
# APPROX_MODEL_HIKE_URL=
# APPROX_MODEL_SONA_URL=
# APPROX_MODEL_FAB_URL=
# APPROX_MODEL_DEFAULT_URL=
# Transactional email (required for signup verification + password reset in production)
MAIL_TRANSPORT=http
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_API_KEY=
MAIL_FROM=Approx AI <no-reply@your-domain.example>
# Optional web search backend for Approx Research
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
# Optional ClamAV daemon client for upload scanning
CLAMDSCAN_PATH=
# Quota (spec defaults)
QUOTA_WINDOW_MINUTES=60
QUOTA_WINDOW_LIMIT=100
QUOTA_CYCLE_DAYS=2
