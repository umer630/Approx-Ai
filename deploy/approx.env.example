# Copy to approx.env and fill in. NEVER commit approx.env.
APPROX_PUBLIC_URL=https://ai.your-domain.example
APPROX_TRUST_PROXY=1
APPROX_BUILD_ID=
# Inference. Point each family at the Approx inference server (inference/server.py). Leave *_NAME unset:
# the backend then addresses the registry-activated version ("nick-4.8@1.0.0") and refuses to serve a
# model that has no active version. Set *_NAME only for an external OpenAI-compatible provider.
APPROX_MODEL_NICK_URL=http://inference:8000/v1
APPROX_MODEL_NICK_KEY=            # = INFERENCE_API_KEY of the inference server
# APPROX_MODEL_HIKE_URL=  APPROX_MODEL_HIKE_KEY=
# APPROX_MODEL_SONA_URL=  APPROX_MODEL_SONA_KEY=
# APPROX_MODEL_FAB_URL=   APPROX_MODEL_FAB_KEY=
# Model registry (release artifacts from the training pipeline)
APPROX_MODELS_DIR=/models
APPROX_AUTO_ACTIVATE=off          # off | production (auto-activate only production-ready releases) | validated
APPROX_INFERENCE_ADMIN_URL=http://inference:8000
APPROX_INFERENCE_ADMIN_KEY=       # = INFERENCE_ADMIN_KEY of the inference server
APPROX_RELEASE_SIGNING_KEY=       # optional; when set, unsigned releases are refused
# Optional media pipelines (FAB 500X). Unset → the endpoints answer 501 capability_unavailable.
APPROX_VIDEO_PIPELINE_URL=
APPROX_VIDEO_UNDERSTANDING_URL=
APPROX_VISION_URL=
APPROX_AUDIO_URL=
# Transactional email (required for signup verification + password reset in production)
MAIL_TRANSPORT=http
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_API_KEY=
MAIL_FROM=Approx AI <no-reply@your-domain.example>
# Optional web search backend for Approx Research
SEARCH_API_ENDPOINT=
SEARCH_API_KEY=
# Optional ClamAV daemon client for upload scanning
CLAMDSCAN_PATH=
# Quota (spec defaults)
QUOTA_WINDOW_MINUTES=60
QUOTA_WINDOW_LIMIT=100
QUOTA_CYCLE_DAYS=2
