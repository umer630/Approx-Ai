# Copy to inference.env (never commit). Generate keys with: openssl rand -hex 32
INFERENCE_API_KEY=
INFERENCE_ADMIN_KEY=
# Optional: only one GPU model family per server, e.g. INFERENCE_MODELS=nick-4.8
INFERENCE_MODELS=
# Optional: required only for gated base models
HF_TOKEN=
# Optional: must equal the backend's APPROX_RELEASE_SIGNING_KEY when releases are signed
APPROX_RELEASE_SIGNING_KEY=
