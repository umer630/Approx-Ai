# Nick 4.8 GPU inference server (inference/server.py). Copy to inference.env (NEVER commit).
# Generate keys with: openssl rand -hex 32

# Auth
INFERENCE_API_KEY=          # the backend sends this as a bearer token (APPROX_MODEL_NICK_KEY)
INFERENCE_ADMIN_KEY=        # bearer for /admin/reload (APPROX_INFERENCE_ADMIN_KEY on the backend)

# Serve ONLY Nick 4.8 on this GPU host
INFERENCE_MODELS=nick-4.8

# HARD PIN the recovered Nick 4.8 adapter: the server refuses to serve any other weights (no substitution).
# This is the SHA-256 of adapter/adapter_model.safetensors for the recovered Nick 4.8 adapter.
INFERENCE_PIN_SHA256=nick-4.8=2faae21620ef0aea6140b296b43ab5fcf5ba2c5b721067f91797b288a09c34c4

# Base model is LOCKED to Qwen/Qwen2.5-3B-Instruct in the release manifest; the server verifies it.
# HF_TOKEN only if the base model becomes gated (never logged):
HF_TOKEN=

# Must equal the backend's APPROX_RELEASE_SIGNING_KEY if releases are signed:
APPROX_RELEASE_SIGNING_KEY=

# GPU memory (4-bit NF4 inference of Qwen2.5-3B + the LoRA adapter):
#   * Minimum  : ~6 GB VRAM free (fits a free Colab/Kaggle T4 16 GB with room to spare)
#   * Recommended: 8 GB+ VRAM. Compute capability >= 7.0 (bitsandbytes 4-bit).
#   * No GPU  -> the server stays up for /health but refuses to load (GPU_REQUIRED); it never runs on CPU.
