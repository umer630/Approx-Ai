{
  "schema": "approx.catalog/v1",
  "_comment": "Single source of truth for the product model catalog: models, their kind, capabilities, base models and the efficiency modes. The frontend, Android app and public API read this through the backend (never hard-code model behaviour in a client). Trained adapters are NOT listed here: they are discovered from the model registry directory (APPROX_MODELS_DIR) as versioned, verified releases.",

  "default_mode": "medium",
  "efficiency_modes": {
    "low": {
      "label": "Low",
      "description": "Fastest and cheapest: short, direct answers with a small context window.",
      "max_tokens": 384,
      "temperature": 0.7,
      "top_p": 0.9,
      "frequency_penalty": 0.0,
      "context_chars": 8000,
      "guidance": "Answer briefly: give the direct answer in a few sentences without extra detail."
    },
    "medium": {
      "label": "Medium",
      "description": "Balanced speed and depth for everyday use.",
      "max_tokens": 1024,
      "temperature": 0.7,
      "top_p": 0.9,
      "frequency_penalty": 0.0,
      "context_chars": 24000,
      "guidance": "Answer directly and efficiently."
    },
    "high": {
      "label": "High",
      "description": "Most thorough: longer, carefully checked answers with the largest context window. Slower.",
      "max_tokens": 4096,
      "temperature": 0.4,
      "top_p": 0.9,
      "frequency_penalty": 0.0,
      "context_chars": 48000,
      "guidance": "Work carefully: reason step by step internally, check your work, and give a thorough, well-structured answer."
    }
  },

